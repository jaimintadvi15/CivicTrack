# Supabase Frontend Configuration (Safe for Browser/Client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Edge Functions / Backend Secrets (Set via `supabase secrets set` or backend env)
# NEVER prefix with VITE_ to prevent client-side exposure!
AI_API_KEY="sk-ant-..."
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-6"

# Optional App Host URL
APP_URL="https://your-app.vercel.app"
